rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== HELPER FUNCTIONS ====================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true;
    }
    
    // Check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user is a specific role
    function hasRole(role) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    // Check if barber is approved
    function isApprovedBarber() {
      return isAuthenticated() && 
             hasRole('barber') &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    
    // ==================== ADMIN COLLECTION ====================
    
    match /admins/{adminId} {
      // Only admins can read admin list (for security)
      allow read: if isAdmin();
      // Only existing admins can create new admins (manual bootstrap required)
      allow write: if isAdmin();
    }
    
    // ==================== USERS COLLECTION ====================
    
    match /users/{userId} {
      // Anyone authenticated can read approved barber profiles
      allow read: if isAuthenticated() && 
                    (resource.data.role == 'barber' && resource.data.status == 'approved');
      
      // Users can read their own data
      allow read: if isOwner(userId);
      
      // Users can update their own profile (except sensitive fields)
      allow update: if isOwner(userId) && 
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy']);
      
      // Only during signup (no existing user doc)
      allow create: if isOwner(userId) && 
                      request.resource.data.role in ['customer', 'barber'];
      
      // Admins can read ALL users
      allow read: if isAdmin();
      
      // Admins can update barber status and approval fields
      allow update: if isAdmin();
      
      // Subcollection: User transactions (wallet)
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) || isAdmin();
      }
    }
    
    // ==================== BOOKINGS COLLECTION ====================
    
    match /bookings/{bookingId} {
      // Customers can read their own bookings
      allow read: if isAuthenticated() && 
                    resource.data.customerId == request.auth.uid;
      
      // Approved barbers can read their bookings
      allow read: if isApprovedBarber() && 
                    resource.data.barberId == request.auth.uid;
      
      // Customers can create bookings
      allow create: if isAuthenticated() && 
                      request.resource.data.customerId == request.auth.uid;
      
      // Both customer and barber can update their bookings (status changes)
      allow update: if isAuthenticated() && 
                      (resource.data.customerId == request.auth.uid || 
                       resource.data.barberId == request.auth.uid);
      
      // Admins have full access
      allow read, write: if isAdmin();
    }
    
    // ==================== BARBER AVAILABILITY ====================
    
    match /barberAvailability/{availabilityId} {
      // Anyone can read approved barber availability
      allow read: if isAuthenticated();
      
      // Barbers can update their own availability
      allow write: if isApprovedBarber() && 
                     request.resource.data.barberId == request.auth.uid;
      
      // Admins have full access
      allow read, write: if isAdmin();
    }
    
    // ==================== REVIEWS COLLECTION ====================
    
    match /reviews/{reviewId} {
      // Anyone can read non-hidden reviews
      allow read: if isAuthenticated() && 
                    (!resource.data.keys().hasAny(['isHidden']) || resource.data.isHidden == false);
      
      // Customers can create reviews for their completed bookings
      allow create: if isAuthenticated() && 
                      request.resource.data.customerId == request.auth.uid;
      
      // Customers can update their own reviews
      allow update: if isAuthenticated() && 
                      resource.data.customerId == request.auth.uid &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isHidden', 'hiddenReason']);
      
      // Admins can read all and hide reviews
      allow read, write: if isAdmin();
    }
    
    // ==================== ADMIN LOGS ====================
    
    match /adminLogs/{logId} {
      // Only admins can read logs
      allow read: if isAdmin();
      // Logs are write-only from server/admin functions
      allow write: if isAdmin();
    }
    
    // ==================== DEFAULT DENY ====================
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
