rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== HELPER FUNCTIONS ====================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is an admin (UID exists in 'admins' collection)
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==================== ADMINS COLLECTION ====================
    // STRICT: Only admins can read or write to this collection
    
    match /admins/{userId} {
      allow read, write: if isAdmin();
    }

    // ==================== USERS COLLECTION ====================
    // Every user (customer or barber) has a profile document here.
    // This is the PRIMARY user store that the app reads on every login.
    //
    // WITHOUT these rules, the app cannot read user data after login,
    // causing infinite loading → "try again or logout" screen.
    
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      
      // Authenticated users can read APPROVED barber profiles (for map/search)
      allow read: if isAuthenticated() && 
                    resource.data.role == 'barber' && resource.data.status == 'approved';
      
      // Admins can read all users
      allow read: if isAdmin();
      
      // Users can create their own profile during signup
      // Role must be either 'customer' or 'barber'
      allow create: if isOwner(userId) && 
                      request.resource.data.role in ['customer', 'barber'];
      
      // Users can update their own profile EXCEPT sensitive fields
      // Unapproved barbers cannot set isOnline=true
      allow update: if isOwner(userId) && 
                      !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['role', 'status', 'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy']) &&
                      (resource.data.role != 'barber' || 
                       resource.data.status == 'approved' || 
                       request.resource.data.isOnline != true);
      
      // Admins have full write access (approve, reject, disable, etc.)
      allow write: if isAdmin();
      
      // Subcollection: User transactions (wallet)
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if false; // Cloud Functions ONLY
      }
    }
    
    // ==================== PHONE REGISTRY ====================
    // Enforces one-phone-one-account rule.
    // Document ID = E.164 phone number (e.g. "+923001234567")
    // Created during signup; immutable after creation.
    //
    // WITHOUT these rules, signup fails because the app cannot
    // check phone uniqueness or register new phone numbers.
    
    match /phone_registry/{phoneNumber} {
      // Point-reads (get by exact E.164 number) are allowed WITHOUT auth so the
      // login screen can resolve "phone → email" before the user signs in.
      // List/queries still require authentication, so the collection cannot
      // be enumerated — a caller must already know the exact number.
      allow get: if true;
      allow list: if isAuthenticated();
      
      // Can only create for your own userId (during signup)
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
      
      // Owners may backfill ONLY the `email` field on their own entry
      // (legacy entries created before emails were stored). Everything else
      // stays immutable.
      allow update: if isAuthenticated() &&
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['email']);
      
      // Phone registry entries cannot be deleted by users
      allow delete: if false;
      
      // Admins have full access (for account management)
      allow read, write: if isAdmin();
    }

    // ==================== BARBER APPLICATIONS ====================
    // Tracks barber onboarding: draft → submitted → underReview → approved/rejected
    //
    // Barbers need CREATE (during signup) and limited UPDATE (document uploads,
    // auto-submit). Without CREATE, barber signup fails.
    // Without UPDATE, barbers cannot upload documents in the application portal.
    
    match /barber_applications/{barberId} {
      // READ:
      // 1. Admins have full read access
      // 2. Barbers can read their own application
      // 3. Authenticated users can read approved barber applications
      allow read: if isAdmin() 
                  || isOwner(barberId)
                  || (isAuthenticated() && resource.data.status == 'approved');

      // Barbers can create their own application during signup
      allow create: if isOwner(barberId);
      
      // Barbers can update their own application:
      //  Case 1: Document uploads — no restricted fields touched
      //  Case 2: Auto-submit — change status to 'submitted' ONLY from
      //          'draft', 'pending', or 'needMoreDocs'
      //          (barber CANNOT set status to approved, rejected, underReview, etc.)
      allow update: if isOwner(barberId) && 
                      (
                        // Case 1: Normal document uploads — no restricted fields
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['status', 'reviewedBy', 'approvedBy', 'rejectedBy', 'approvedAt', 'rejectedAt'])
                        ||
                        // Case 2: Auto-submit after uploading all documents
                        (
                          request.resource.data.status == 'submitted' &&
                          resource.data.status in ['draft', 'pending', 'needMoreDocs'] &&
                          !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['reviewedBy', 'approvedBy', 'rejectedBy', 'approvedAt', 'rejectedAt'])
                        )
                      );
      
      // Admins have full write access (approve, reject, request docs, etc.)
      allow write: if isAdmin();
    }

    // ==================== ADMIN LOGS ====================
    // SERVER-ONLY CREATION (Cloud Functions)
    
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if false; // Cloud Functions ONLY
      allow update, delete: if false;
    }

    // ==================== BOOKINGS COLLECTION ====================
    
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && 
                    (isAdmin() || 
                     resource.data.customerId == request.auth.uid || 
                     resource.data.barberId == request.auth.uid);

      // ── Statuses only a BARBER may set (acceptance lifecycle) ──
      // 'confirmed' is this app's stored value for "accepted".
      function isBarberOnlyStatus(s) {
        return s in ['accepted', 'confirmed', 'rejected', 'completed'];
      }

      // CUSTOMER — create: must be the booking's customer, and a new booking
      // can ONLY start in 'pending'. Customers can never create an accepted one.
      allow create: if isAuthenticated() &&
                      request.auth.uid == request.resource.data.customerId &&
                      request.resource.data.status == 'pending';

      // CUSTOMER — update (cancel / reschedule / reroute / 15-min auto-reroute):
      // must own the booking, may NOT reassign it to someone else, and the
      // resulting status must never be a barber-only status (so a customer
      // cannot flip their own booking to 'accepted'/'confirmed'/'completed').
      allow update: if isAuthenticated() &&
                      request.auth.uid == resource.data.customerId &&
                      request.resource.data.customerId == resource.data.customerId &&
                      !isBarberOnlyStatus(request.resource.data.status);

      // BARBER — update: must be the ASSIGNED barber and may only move the
      // booking to accepted/confirmed, rejected, or completed. Reassigning the
      // booking (barberId / customerId) is not allowed.
      // The assigned barber may also release the booking (decline / emergency
      // cancel) by setting 'rerouting' or 'cancelledByBarber'.
      allow update: if isAuthenticated() &&
                      request.auth.uid == resource.data.barberId &&
                      request.resource.data.barberId == resource.data.barberId &&
                      request.resource.data.customerId == resource.data.customerId &&
                      (isBarberOnlyStatus(request.resource.data.status) ||
                       request.resource.data.status in ['rerouting', 'cancelledByBarber']);

      // BARBER — hand-off: after releasing a booking ('rerouting'), the
      // releasing barber may assign it to a DIFFERENT barber as a fresh
      // 'pending' request, and must be on the rejectedByBarbers ignore list.
      allow update: if isAuthenticated() &&
                      request.auth.uid == resource.data.barberId &&
                      resource.data.status == 'rerouting' &&
                      request.resource.data.status == 'pending' &&
                      request.resource.data.customerId == resource.data.customerId &&
                      request.resource.data.barberId != request.auth.uid &&
                      request.auth.uid in request.resource.data.get('rejectedByBarbers', []);

      // Nobody deletes bookings from the client.
      allow delete: if false;

      // Admins / Cloud Functions retain full access.
      allow write: if isAdmin();
    }

    // ==================== REVIEWS COLLECTION ====================
    
    match /reviews/{reviewId} {
      allow read: if isAdmin() || resource.data.visibility == 'VISIBLE';
      allow write: if false; // Cloud Functions ONLY
    }

    // ==================== WALLETS ====================
    
    match /wallets/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow write: if false; // Cloud Functions ONLY
    }

    // ==================== TRANSACTIONS ====================
    // SERVER-ONLY (Cloud Functions)
    
    match /transactions/{txId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if false; // Cloud Functions ONLY
      allow update, delete: if false;
    }

    // ==================== BARBER SERVICES (PRICING & MENU) ====================
    // Each service document belongs to a single barber (field: barberId).
    // Barbers can CRUD their own services. Customers can read enabled services.
    
    match /barberServices/{serviceId} {
      // Anyone authenticated can read services (customers need this for booking)
      allow read: if isAuthenticated();
      
      // Barbers can create services under their own barberId
      allow create: if isAuthenticated() && 
                      request.resource.data.barberId == request.auth.uid;
      
      // Barbers can update/delete only their own services
      allow update, delete: if isAuthenticated() && 
                              resource.data.barberId == request.auth.uid;
      
      // Admins have full access
      allow read, write: if isAdmin();
    }

    // ==================== SLOTS (BARBER AVAILABILITY) ====================
    
    match /slots/{slotId} {
      // Anyone authenticated can read slot availability
      allow read: if isAuthenticated();
      
      // Approved barbers can manage their own slots (slotId starts with their uid)
      allow write: if isAuthenticated() && 
                     slotId.matches(request.auth.uid + '_.*');
      
      // Admins have full access
      allow read, write: if isAdmin();
    }

    // ==================== GEO-ZONES ====================
    
    match /geo_zones/{zoneId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==================== PLATFORM CONFIGURATION ====================
    // READ-ONLY for Admin UI. Cloud Functions ONLY for writes.
    
    match /platform/config {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions ONLY
      
      // Config Version History — immutable audit trail
      match /versions/{versionId} {
        allow read: if isAdmin();
        allow create: if false; // Cloud Functions ONLY
        allow update, delete: if false; // IMMUTABLE
      }
    }

    // ==================== NOTIFICATIONS ====================
    
    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ==================== DISPUTES ====================
    
    match /disputes/{disputeId} {
      allow read: if isAdmin() || 
                    (isAuthenticated() && 
                      (request.auth.uid == resource.data.reporterId || 
                       request.auth.uid == resource.data.targetId));
      allow write: if false; // Cloud Functions ONLY
    }

    // ==================== ENFORCEMENT LOGS ====================
    
    match /admin_enforcement_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; 
    }

    // ==================== BARBER EARNINGS (Phase 3) ====================
    // Records of earnings per completed job.
    // Read: Admin or the barber who earned. Write: Cloud Functions only.
    
    match /barber_earnings/{earningId} {
      allow read: if isAdmin() || 
                    (isAuthenticated() && resource.data.barberId == request.auth.uid);
      allow write: if false; // Cloud Functions / BookingEngine ONLY
    }

    // ==================== DEFAULT DENY ====================
    // Deny access to all other collections
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
