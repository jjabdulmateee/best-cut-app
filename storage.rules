rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ==================== BARBER DOCUMENTS ====================
    // Barbers can upload application documents to their own folder.
    // Path: barber_documents/{userId}/{filename}
    
    match /barber_documents/{userId}/{allPaths=**} {
      // Barbers can read and write their own documents
      allow read, write: if request.auth != null && request.auth.uid == userId
                         && request.resource.size < 10 * 1024 * 1024  // Max 10 MB
                         && request.resource.contentType.matches('image/.*');

      // Barbers can read their own uploads (no size/type check on reads)
      allow read: if request.auth != null && request.auth.uid == userId;

      // Admins can read all barber documents (for review)
      // Note: Admin check via Firestore lookup is not available in Storage rules.
      // Admin access is handled via Firebase Admin SDK on the backend.
    }

    // ==================== DEFAULT DENY ====================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
